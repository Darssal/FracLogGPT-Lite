{
  "experiment": "SMOKE_CHAIN",
  "model": "Qwen/Qwen3.5-4B",
  "method": "chained local smoke test",
  "stages": {
    "dapt": {
      "command": "pt",
      "args": {
        "model": "Qwen/Qwen3.5-4B",
        "use_hf": true,
        "tuner_type": "lora",
        "dataset": "outputs/data/dapt_smoke.jsonl",
        "torch_dtype": "float16",
        "learning_rate": "1e-4",
        "max_steps": 1,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 1,
        "lora_rank": 8,
        "lora_alpha": 32,
        "target_modules": "all-linear",
        "freeze_vit": true,
        "freeze_aligner": true,
        "max_length": 256,
        "output_dir": "outputs/smoke_chain/checkpoints/dapt"
      }
    },
    "sft": {
      "command": "sft",
      "args": {
        "model": "Qwen/Qwen3.5-4B",
        "use_hf": true,
        "adapters": "${checkpoint:dapt}",
        "tuner_type": "lora",
        "dataset": "outputs/data/sft_smoke.jsonl",
        "torch_dtype": "float16",
        "learning_rate": "1e-4",
        "max_steps": 1,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 1,
        "lora_rank": 8,
        "lora_alpha": 32,
        "target_modules": "all-linear",
        "freeze_vit": true,
        "freeze_aligner": true,
        "max_length": 256,
        "truncation_strategy": "left",
        "output_dir": "outputs/smoke_chain/checkpoints/sft"
      }
    },
    "rlhf": {
      "command": "rlhf",
      "args": {
        "rlhf_type": "dpo",
        "model": "Qwen/Qwen3.5-4B",
        "use_hf": true,
        "adapters": "${checkpoint:sft}",
        "ref_adapters": "${checkpoint:sft}",
        "tuner_type": "lora",
        "dataset": "outputs/data/pref_smoke.jsonl",
        "torch_dtype": "float16",
        "learning_rate": "1e-4",
        "max_steps": 1,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 1,
        "lora_rank": 8,
        "lora_alpha": 32,
        "target_modules": "all-linear",
        "freeze_vit": true,
        "freeze_aligner": true,
        "beta": 0.1,
        "max_length": 256,
        "truncation_strategy": "left",
        "output_dir": "outputs/smoke_chain/checkpoints/dpo"
      }
    },
    "rlhf_simpo": {
      "command": "rlhf",
      "args": {
        "rlhf_type": "simpo",
        "model": "Qwen/Qwen3.5-4B",
        "use_hf": true,
        "adapters": "${checkpoint:sft}",
        "tuner_type": "lora",
        "dataset": "outputs/data/pref_smoke.jsonl",
        "torch_dtype": "float16",
        "learning_rate": "1e-4",
        "max_steps": 1,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 1,
        "lora_rank": 8,
        "lora_alpha": 32,
        "target_modules": "all-linear",
        "freeze_vit": true,
        "freeze_aligner": true,
        "beta": 2.0,
        "simpo_gamma": 1.0,
        "cpo_alpha": 0.0,
        "max_length": 256,
        "truncation_strategy": "left",
        "output_dir": "outputs/smoke_chain/checkpoints/simpo"
      }
    }
  }
}
